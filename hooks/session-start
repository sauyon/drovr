#!/usr/bin/env bash
# SessionStart hook for the drovr plugin.
#
# The always-on reflex for human-initiated Claude Code sessions: inject the
# `drovr:using-drovr` router skill so the agent's default operating mode is
# drovr's single-writer, clean-context discipline.
#
# This hook is deliberately thin: it resolves the skill path and delegates
# rendering to `drovr reflex`, which shapes the reflex per the user's `[reflex]`
# config (master switch, preamble override, per-section toggles) and emits the
# SessionStart hook JSON. Keeping the config-driven logic in the CLI keeps it
# unit-testable and unifies configuration with the rest of drovr's config.toml.
#
# Suppression contract: drovr spawns each phase agent with DROVR_PHASE set (see
# `drovr phase start`). Inside such a phase the agent runs purely on its
# injected handoff, so re-deriving the discipline would fight that contract —
# when DROVR_PHASE is set and non-empty we no-op before spawning anything.

set -euo pipefail

# 1. Suppression: no-op inside a drovr-spawned phase.
if [ -n "${DROVR_PHASE:-}" ]; then
  exit 0
fi

# 2. Resolve the plugin root. Claude Code sets CLAUDE_PLUGIN_ROOT; fall back to
#    the script's parent dir so the hook is testable standalone.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT}"
else
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

skill_path="${PLUGIN_ROOT}/skills/using-drovr/SKILL.md"

# 3. Delegate to the drovr CLI. It reads the skill, applies `[reflex]` config,
#    and prints the hook JSON (or nothing when the reflex is disabled). $DROVR_BIN
#    overrides the binary — tests point it at the freshly built binary; in a real
#    session `drovr` is on PATH. `exec` hands drovr's stdout and exit status to
#    Claude Code directly, so a missing binary or an unreadable skill fails loudly
#    (non-zero) rather than injecting a poisoned or partial context.
exec "${DROVR_BIN:-drovr}" reflex --skill "$skill_path"
